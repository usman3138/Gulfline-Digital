# Names only — never put real values in this file.
# This is a static site with no .env. The only settings are the two values in
# supabase-config.js (Supabase dashboard -> Project Settings -> API).
# Both are public by design (the anon key is meant to be in page code).
# Never put the Supabase service_role key anywhere in this repo.

SUPABASE_URL=
SUPABASE_ANON_KEY=
